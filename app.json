{
  "expo": {
    "name": "Marc Gomes Sud Vendée",
    "slug": "rapport-intervention-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rapportinterventionmobile",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/f6d5acc0-0999-4501-837d-ec0f184bfdbe"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "fr.ramonagemarcgomes.rapport",
      "adaptiveIcon": {
        "backgroundColor": "#BA1E26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#BA1E26",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/barlow-condensed/600SemiBold/BarlowCondensed_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/barlow-condensed/700Bold/BarlowCondensed_700Bold.ttf",
            "./node_modules/@expo-google-fonts/barlow-condensed/800ExtraBold/BarlowCondensed_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/figtree/400Regular/Figtree_400Regular.ttf",
            "./node_modules/@expo-google-fonts/figtree/500Medium/Figtree_500Medium.ttf",
            "./node_modules/@expo-google-fonts/figtree/600SemiBold/Figtree_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/figtree/700Bold/Figtree_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "L'appareil photo sert à photographier le conduit ou un défaut pour l'ajouter au rapport.",
          "photosPermission": "L'accès aux photos sert à joindre une photo existante au rapport.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6d5acc0-0999-4501-837d-ec0f184bfdbe"
      }
    }
  }
}
